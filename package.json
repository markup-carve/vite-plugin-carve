{
  "name": "@markup-carve/vite-plugin-carve",
  "version": "0.1.0",
  "type": "module",
  "description": "Vite plugin for importing Carve documents as rendered HTML",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "node --test dist/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@markup-carve/carve": "git+https://github.com/markup-carve/carve-js.git#4caa3ba"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  }
}
